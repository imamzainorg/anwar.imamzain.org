---
import { type Locale } from '@/site.config';
import { CONTENT } from '@/i18n/content';
import StoreButtons from './StoreButtons.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = CONTENT[locale];
---
{/* The final flourish — the app's gold-gradient squircle at band scale. */}
<section class="section cta-band">
  <div class="pattern pattern--ink"></div>
  <div class="wrap cta-band__inner reveal">
    <h2>{c.finalCta.title}</h2>
    <p>{c.finalCta.subtitle}</p>
    <StoreButtons locale={locale} />
    <p class="hero__hint cta-band__hint"><Icon name="gift" size={16} /> {c.hero.freeLabel} · {c.hero.platformsLabel}</p>
  </div>
</section>
