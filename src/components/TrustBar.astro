---
import { type Locale } from '@/site.config';
import { CONTENT } from '@/i18n/content';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = CONTENT[locale];
const icons = ['gift', 'sparkle', 'shield-check', 'moon'];
---
{/* One olive capsule with hairline dividers — the app's pill rows with
    "value | value" metadata, plus its mini gold squircle icons. */}
<section class="trust section--tight" aria-label="Trust">
  <div class="wrap">
    <div class="trust__band reveal">
      {c.trust.items.map((item, i) => (
        <div class="trust__item">
          <span class="trust__ic"><Icon name={icons[i] ?? 'check'} /></span>
          <span>
            <span class="trust__v">{item.value}</span>
            <span class="trust__l">{item.label}</span>
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
