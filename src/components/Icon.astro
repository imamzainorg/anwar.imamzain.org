---
/**
 * Inline SVG icon set. Line icons (stroke) for UI/features; two filled glyphs
 * for the store badges. Everything inlined — no icon-font, no image requests.
 */
interface Props {
  name: string;
  class?: string;
  size?: number;
}
const { name, class: klass, size = 24 } = Astro.props;

// Stroke icons (24x24, currentColor stroke)
const STROKE: Record<string, string> = {
  check: '<polyline points="20 6 9 17 4 12"/>',
  'book-open': '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
  scroll: '<path d="M8 3H5a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h3"/><path d="M19 17V5a2 2 0 0 0-2-2H8"/><path d="M8 21h9a2 2 0 0 0 2-2 2 2 0 0 0-2-2H6a1 1 0 0 1-1-1V8"/><path d="M16 3v0"/>',
  quote: '<path d="M9 8H5a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h3v3a2 2 0 0 1-2 2"/><path d="M20 8h-4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h3v3a2 2 0 0 1-2 2"/>',
  landmark: '<path d="M12 3 3 8h18z"/><path d="M5 8v8"/><path d="M10 8v8"/><path d="M14 8v8"/><path d="M19 8v8"/><path d="M3 20h18"/><path d="M3 16h18"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M8 2v4"/><path d="M16 2v4"/><path d="M3 10h18"/>',
  star: '<path d="M12 2.5 15 9l7 .8-5.2 4.7L18.5 22 12 18.3 5.5 22l1.7-7.5L2 9.8 9 9z"/>',
  'moon-star': '<path d="M18 5a9 9 0 1 1-6 15.7A7 7 0 0 0 18 5z"/><path d="M18.5 2.5 19 4l1.5.5L19 5l-.5 1.5L18 5l-1.5-.5L18 4z"/>',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>',
  library: '<path d="M6 4v16"/><path d="M10 4v16"/><path d="m14 5 4 15"/><path d="M4 20h13"/><path d="M4 4h8"/>',
  download: '<path d="M12 3v12"/><path d="m7 11 5 5 5-5"/><path d="M5 21h14"/>',
  gift: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"/><path d="M12 8S10.5 3 7.5 4.2 9 8 12 8zM12 8s1.5-5 4.5-3.8S15 8 12 8z"/>',
  'shield-check': '<path d="M12 2 4 5v6c0 5 3.5 8 8 11 4.5-3 8-6 8-11V5z"/><polyline points="9 12 11.5 14.5 16 10"/>',
  smartphone: '<rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M11 18h2"/>',
  sparkle: '<path d="M12 3v6M12 15v6M3 12h6M15 12h6"/><path d="m6.5 6.5 3 3M14.5 14.5l3 3M17.5 6.5l-3 3M9.5 14.5l-3 3"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z"/>',
  heart: '<path d="M12 20s-7-4.5-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 5c-2.5 4.5-9.5 9-9.5 9z"/>',
};

// Filled brand glyphs (24x24, currentColor fill)
const FILL: Record<string, string> = {
  apple:
    '<path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.032 1.52-.062 2.09-.984 3.928-.984 1.828 0 2.35.984 3.96.946 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.036-.013-3.19-1.24-3.22-4.859-.026-3.026 2.476-4.478 2.59-4.545-1.416-2.078-3.612-2.309-4.386-2.35-2-.156-3.675 1.09-4.622 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/>',
  'google-play':
    '<path d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.192l11.04 10.986zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z"/>',
};

const isFill = name in FILL;
const body = isFill ? FILL[name] : STROKE[name];
---
{isFill ? (
  <svg class={klass} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={body} />
) : (
  <svg class={klass} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={body} />
)}
